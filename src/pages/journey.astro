---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import JourneyDashboard from '../react/JourneyDashboard';

const monthlyPosts = (
  await getCollection('blog', ({ data }) => !data.draft && data.category === '월간결산')
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="자산 여정"
  description="29세에서 50세까지 — 꼬마빌딩을 향한 20년 자산 항해. 진행률 대시보드와 월간 결산 기록."
>
  <h1 class="font-display mb-4 text-3xl font-semibold">20년의 항해</h1>

  <div class="text-muted mb-10 max-w-2xl space-y-4 leading-relaxed">
    <p>
      목적지는 하나입니다. <strong class="text-cream">1층에 카페가 있는 꼬마빌딩.</strong>
      1층 카페에는 좋은 커피와 피규어가 있고, 위층은 임대를 줍니다. 29살에 출항해 50살에 도착하는
      계획이고, 이 페이지는 그 항해의 현재 위치를 보여줍니다.
    </p>
    <p>
      항로는 세 개의 버킷으로 나뉩니다 — <span class="text-sage">금융자산</span>(배당·지수 투자),
      <span class="text-sage">아파트</span>(거주 안정), <span class="text-sage">빌딩 종잣돈</span>(최종 목적지).
      금액은 공개하지 않습니다. 대신 목표 대비 진행률과 시간의 흐름을 매달 기록합니다.
      건물의 불이 한 층씩 켜지는 걸 함께 지켜봐 주세요.
    </p>
  </div>

  <!-- 대시보드 (공개 모드) -->
  <div class="mb-14">
    <JourneyDashboard client:visible />
  </div>

  <!-- 월간 결산 목록 -->
  <section class="mb-14" aria-labelledby="monthly-log">
    <h2 id="monthly-log" class="font-display mb-5 text-2xl font-semibold">월간 결산</h2>
    {
      monthlyPosts.length > 0 ? (
        <div class="grid gap-4">
          {monthlyPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="text-muted">첫 월간 결산을 준비 중입니다.</p>
      )
    }
  </section>

  <NewsletterCTA />
</BaseLayout>
