---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import JourneyDashboard from '../react/JourneyDashboard';
import { SITE_TAGLINE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <!-- 히어로 -->
  <section class="pt-6 pb-14 text-center sm:pt-12">
    <h1 class="font-display text-brass text-5xl font-semibold tracking-tight sm:text-6xl">
      laughtale
    </h1>
    <p class="text-cream mt-4 text-lg sm:text-xl">{SITE_TAGLINE}</p>
    <p class="text-muted mx-auto mt-3 max-w-xl leading-relaxed">
      위대한 항해의 마지막 섬. 29살의 커피 한 잔에서 시작해, 50살의
      1층 카페가 있는 꼬마빌딩까지 — 그 20년의 항해 일지입니다.
    </p>
  </section>

  <!-- 자산 여정 진행률 요약 (공개 모드) -->
  <section class="mb-14" aria-labelledby="journey-summary">
    <h2 id="journey-summary" class="sr-only">자산 여정 진행률 요약</h2>
    <JourneyDashboard compact />
    <p class="mt-3 text-right">
      <a href="/journey" class="text-brass hover:text-brass-lt text-sm underline underline-offset-4">
        여정 전체 보기 →
      </a>
    </p>
  </section>

  <!-- 최근 글 -->
  <section class="mb-14" aria-labelledby="recent-posts">
    <div class="mb-5 flex items-baseline justify-between">
      <h2 id="recent-posts" class="font-display text-2xl font-semibold">최근 항해 기록</h2>
      <a href="/blog" class="text-muted hover:text-cream text-sm transition-colors">전체 글 →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    {posts.length === 0 && <p class="text-muted">아직 글이 없습니다. 첫 항해 기록을 준비 중입니다.</p>}
  </section>

  <NewsletterCTA />
</BaseLayout>
