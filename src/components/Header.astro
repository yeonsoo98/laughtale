---
import { SITE_TITLE } from '../consts';

const nav = [
  { href: '/journey', label: '자산 여정' },
  { href: '/blog', label: '블로그' },
  { href: '/toolkit', label: '툴킷' },
  { href: '/about', label: '소개' },
];
const current = Astro.url.pathname;
---

<header class="border-mist/60 bg-ink/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-[880px] items-center justify-between px-5 py-3.5 sm:px-8">
    <a href="/" class="font-display text-brass text-xl font-semibold tracking-tight">
      {SITE_TITLE}
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      <nav aria-label="주 메뉴" class="flex items-center">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={current.startsWith(item.href) ? 'page' : undefined}
              class:list={[
                'rounded px-2 py-1.5 text-[0.9rem] transition-colors sm:px-3',
                current.startsWith(item.href)
                  ? 'text-brass font-semibold'
                  : 'text-muted hover:text-cream',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <button
        id="theme-toggle"
        type="button"
        aria-label="라이트/다크 모드 전환"
        class="text-muted hover:text-cream border-mist hover:border-brass ml-1 rounded-full border p-1.5 transition-colors"
      >
        <!-- 달 (다크일 때 표시) -->
        <svg
          class="icon-moon h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
        </svg>
        <!-- 해 (라이트일 때 표시) -->
        <svg
          class="icon-sun hidden h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  function syncIcons() {
    const isLight = document.documentElement.dataset.theme === 'light';
    document.querySelector('.icon-moon')?.classList.toggle('hidden', isLight);
    document.querySelector('.icon-sun')?.classList.toggle('hidden', !isLight);
  }
  syncIcons();
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    syncIcons();
  });
</script>
