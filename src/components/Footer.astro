---
import { SITE_TITLE, CONTACT_EMAIL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-mist/60 border-t">
  <div
    class="text-muted mx-auto flex max-w-[880px] flex-col gap-3 px-5 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p>
      © {year}
      <span class="font-display text-cream">{SITE_TITLE}</span> — 한 층씩, 20년.
    </p>
    <nav aria-label="푸터 메뉴" class="flex flex-wrap gap-x-4 gap-y-1">
      <a class="hover:text-cream transition-colors" href="/rss.xml">RSS</a>
      <a class="hover:text-cream transition-colors" href="/contact">연락</a>
      <a class="hover:text-cream transition-colors" href="/privacy">개인정보처리방침</a>
      <a class="hover:text-cream transition-colors" href={`mailto:${CONTACT_EMAIL}`}>이메일</a>
    </nav>
  </div>
</footer>
