# 사이트 URL (배포 도메인 확정 후 교체 — sitemap/RSS/canonical 에 사용)
PUBLIC_SITE_URL=https://laughtale.pages.dev

# Google AdSense 클라이언트 ID (승인 후 입력, 예: ca-pub-1234567890123456)
# 비워두면 광고 슬롯이 아예 렌더링되지 않는다.
PUBLIC_ADSENSE_CLIENT=

# 뉴스레터 폼 action URL (스티비/Buttondown 등의 구독 폼 주소)
# 비워두면 mailto 폴백으로 동작한다.
PUBLIC_NEWSLETTER_ACTION=
